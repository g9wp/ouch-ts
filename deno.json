{
  "name": "@g9wp/ouch",
  "version": "0.0.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./deno": "./deno.ts",
    "./node": "./node.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "test": "deno test -A",
    "bench": "deno run -A bench.ts",
    "check": "deno check mod.ts deno.ts node.ts mod_test.ts cross_test.ts entry_test.ts bench.ts"
  },
  "publish": {
    "exclude": [
      "!pkg",
      ".github/",
      "build.ts",
      "bench.ts",
      "mod_test.ts",
      "cross_test.ts",
      "fixtures/",
      "ouch/"
    ]
  }
}
